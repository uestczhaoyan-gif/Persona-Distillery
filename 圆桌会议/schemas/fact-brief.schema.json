{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/persona-distill/roundtable/schemas/fact-brief.schema.json",
  "title": "Shared roundtable fact brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brief_id", "session_id", "policy", "question", "as_of", "facts", "sources", "disagreements", "status", "expires_on"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "brief_id": { "type": "string", "pattern": "^FB-[0-9]{8}-[0-9]{3,}$" },
    "session_id": { "type": "string", "pattern": "^RT-[0-9]{8}-[0-9]{3,}$" },
    "policy": { "enum": ["facts_only", "research"] },
    "question": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date-time" },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "claim", "scope", "confidence", "source_ids"],
        "properties": {
          "fact_id": { "type": "string", "pattern": "^F-[0-9]{4}$" },
          "claim": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "confidence": { "enum": ["high", "medium", "low"] },
          "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^S-[0-9]{3,}$" } },
          "notes": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "url", "accessed_at"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^S-[0-9]{3,}$" },
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "published_on": { "type": ["string", "null"], "format": "date" },
          "accessed_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "disagreements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "summary", "source_ids"],
        "properties": {
          "topic": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "source_ids": { "type": "array", "items": { "type": "string", "pattern": "^S-[0-9]{3,}$" } }
        }
      }
    },
    "status": { "enum": ["current", "expired", "superseded"] },
    "expires_on": { "type": "string", "format": "date-time" }
  }
}
