{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/persona-distill/schemas/evidence-card.schema.json",
  "title": "Structured persona evidence card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "card_type",
    "claim",
    "evidence_summary",
    "interpretation",
    "limitations",
    "source_refs",
    "topics",
    "confidence",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "evidence_id": { "type": "string", "pattern": "^E-[0-9]{4}$" },
    "card_type": {
      "enum": [
        "fact",
        "direct_view",
        "decision_case",
        "style_observation",
        "reliable_report",
        "literary_scene",
        "synthesis",
        "change_over_time"
      ]
    },
    "claim": { "type": "string", "minLength": 1 },
    "evidence_summary": { "type": "string", "minLength": 1 },
    "interpretation": { "type": "string", "minLength": 1 },
    "limitations": { "type": "string", "minLength": 1 },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "locations", "chunk_ids"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^P-[0-9]{4}-[0-9]{3}$" },
          "locations": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "chunk_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^P-[0-9]{4}-[0-9]{3}#C-[0-9]{4}$" },
            "uniqueItems": true
          }
        }
      }
    },
    "topics": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "confidence": { "enum": ["high", "medium", "low"] },
    "status": { "enum": ["candidate", "reviewed", "withdrawn"] },
    "delivery_channel": { "enum": ["public", "agent_summary", "local_only"] }
  }
}
