{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/persona-distill/schemas/persona-package-v2.schema.json",
  "title": "Persona package v2 (manifest.v2.json; not loaded by legacy runtime)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "person_id",
    "display_name",
    "package_version",
    "subject_kind",
    "readiness",
    "visibility",
    "source_modes",
    "capabilities",
    "coverage",
    "files",
    "policy_version",
    "sensitive_data",
    "material_basis",
    "execution_policy",
    "distribution_policy",
    "review_status"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "2.0"
    },
    "person_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "package_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "subject_kind": {
      "enum": [
        "historical_public",
        "deceased_private",
        "living_public",
        "living_private",
        "self",
        "fictional"
      ]
    },
    "readiness": {
      "enum": [
        "draft",
        "chat-ready",
        "simulation-ready",
        "publish-ready"
      ]
    },
    "visibility": {
      "enum": [
        "private",
        "public"
      ]
    },
    "source_modes": {
      "type": "array",
      "items": {
        "enum": [
          "web",
          "upload"
        ]
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_chat",
        "roundtable",
        "story_simulation"
      ],
      "properties": {
        "direct_chat": {
          "type": "boolean"
        },
        "roundtable": {
          "type": "boolean"
        },
        "story_simulation": {
          "type": "boolean"
        },
        "themed_lecture": {
          "type": "boolean"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "topics",
        "languages"
      ],
      "properties": {
        "period": {
          "type": "string"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "character_card",
        "sources",
        "evidence",
        "persona_spec",
        "evaluation",
        "dialogue_log",
        "build_report"
      ],
      "properties": {
        "profile": {
          "type": "string"
        },
        "character_card": {
          "type": "string"
        },
        "sources": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "persona_spec": {
          "type": "string"
        },
        "core_anchors": {
          "type": "string"
        },
        "dialogue_examples": {
          "type": "string"
        },
        "evaluation": {
          "type": "string"
        },
        "dialogue_log": {
          "type": "string"
        },
        "build_report": {
          "type": "string"
        },
        "usage_example": {
          "type": "string"
        },
        "avatar_png": {
          "type": "string"
        },
        "avatar_webp": {
          "type": "string"
        },
        "structured_chunks": {
          "type": "string"
        },
        "structured_evidence": {
          "type": "string"
        },
        "context_memory": {
          "type": "string"
        },
        "structured_context_memory": {
          "type": "string"
        },
        "search_index_manifest": {
          "type": "string"
        }
      }
    },
    "policy_version": {
      "const": "1.0"
    },
    "sensitive_data": {
      "type": "boolean"
    },
    "material_basis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "public_source",
          "self_report",
          "user_recollection",
          "authorized_private",
          "original_fiction"
        ]
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "allowed_services"
      ],
      "properties": {
        "mode": {
          "enum": [
            "local_only",
            "declared_services"
          ]
        },
        "allowed_services": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "local_only"
              }
            }
          },
          "then": {
            "properties": {
              "allowed_services": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "declared_services"
              }
            }
          },
          "then": {
            "properties": {
              "allowed_services": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "distribution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "local_only",
            "review_required",
            "public_approved"
          ]
        }
      }
    },
    "review_status": {
      "enum": [
        "candidate",
        "reviewed"
      ]
    },
    "publication_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "reviewer_id",
        "reviewed_on",
        "content_digest"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,127}$"
        },
        "reviewer_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,127}$"
        },
        "reviewed_on": {
          "type": "string",
          "format": "date"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "subject_kind": {
                "enum": [
                  "living_public",
                  "living_private",
                  "deceased_private"
                ]
              }
            }
          },
          {
            "properties": {
              "sensitive_data": {
                "const": true
              }
            }
          },
          {
            "properties": {
              "material_basis": {
                "contains": {
                  "enum": [
                    "authorized_private",
                    "user_recollection"
                  ]
                }
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "execution_policy": {
            "properties": {
              "mode": {
                "const": "local_only"
              }
            }
          },
          "distribution_policy": {
            "properties": {
              "mode": {
                "const": "local_only"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "distribution_policy": {
            "properties": {
              "mode": {
                "const": "local_only"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution_policy": {
            "properties": {
              "mode": {
                "const": "local_only"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "distribution_policy": {
            "properties": {
              "mode": {
                "const": "public_approved"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "publication_review"
        ],
        "properties": {
          "review_status": {
            "const": "reviewed"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "publication_review"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "visibility": {
            "const": "public"
          }
        }
      },
      "then": {
        "properties": {
          "distribution_policy": {
            "properties": {
              "mode": {
                "const": "public_approved"
              }
            }
          },
          "readiness": {
            "enum": [
              "chat-ready",
              "simulation-ready",
              "publish-ready"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "readiness": {
            "enum": [
              "chat-ready",
              "simulation-ready",
              "publish-ready"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "files": {
            "required": [
              "avatar_png",
              "avatar_webp"
            ]
          }
        }
      }
    }
  ]
}
